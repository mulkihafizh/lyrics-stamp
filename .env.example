# ── LYRICS-STAMP Audio Lyrics Specification Studio ──
# Local Music Directory Configuration

# Path to the directory containing your audio files (.flac, .mp3, .ogg, .wav, .m4a)
# Both absolute paths and relative paths (e.g. ./music) are supported.

# Windows example:
MUSIC_DIR=D:/Music

# macOS examples:
# MUSIC_DIR=/Users/username/Music

# Linux examples:
# MUSIC_DIR=/home/username/Music
# MUSIC_DIR=~/Music

# Project relative example:
# MUSIC_DIR=./music
